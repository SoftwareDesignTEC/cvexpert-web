<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para consumir los mocks del APIM (T3). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para saber si hay conexión: lo muestra el indicador de la barra superior. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CvApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CvPro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CvPro"
            android:windowSoftInputMode="adjustResize">
            <!-- Declara esta Activity como la que abre el launcher del teléfono. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Permite entregarle el PDF generado al visor que tenga el usuario, sin exponer
             la ruta real del archivo. Solo hace falta en Android 9 y anteriores: desde
             Android 10 el archivo va a Descargas con MediaStore. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
